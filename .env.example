# ============================================================
# SneakerBot — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- App ---
NODE_ENV=production
PORT=3000

# Random 64-character string used to sign session cookies.
# Generate one with: openssl rand -hex 32
# REQUIRED in production — the app refuses to boot without it, because the built-in
# fallback is public and lets anyone forge a signed session cookie.
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Set to 1 to allow booting production with the built-in fallback secret
# (fine for a throwaway box, not for anything holding payment data).
# ALLOW_INSECURE_SESSION_SECRET=1

# Verify upstream TLS certificates for fetches AND the browser. Default is
# permissive: residential gateways and some CDN edges present chains Node will not
# build, and failing a checkout mid-drop is worse than a theoretical MITM.
# Set to 1 if your exit provider presents clean certificates.
# TLS_VERIFY_STRICT=1

# --- Reverse proxy / TLS ---
# The dashboard and the API are protected by a session, but only as far as the
# transport carrying it. Behind a TLS-terminating proxy set both of these so the
# session cookie is flagged Secure and rate limiting sees real client IPs.
# Leave TRUST_PROXY unset for a direct-exposed instance (default 1 hop).
# TRUST_PROXY=1
# SESSION_COOKIE_SECURE=true
# APP_URL=https://bot.example.com

# --- Browser ---
# Absolute path to your Chrome or Chromium binary.
# Docker / Ubuntu / Debian:  /usr/bin/chromium
# Amazon Linux 2023:         /usr/bin/chromium-browser
# macOS (Homebrew):          /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Database ---
# Leave unset to use the built-in SQLite database (sneakerbot.db in the project root).
# This is the simplest option and works perfectly on a single EC2 instance.
# Set DATABASE_URL to use AWS RDS PostgreSQL instead:
# DATABASE_URL=postgresql://sneakerbot:yourpassword@your-db.region.rds.amazonaws.com:5432/sneakerbot

# --- TLS Sidecar ---
# The Go sidecar auto-generates a random auth token at startup and writes it to
# /tmp/tls-sidecar.token. The Node app reads that file automatically.
# Set this only if you need the token to stay stable across container restarts:
# TLS_SIDECAR_TOKEN=

# --- Browser fingerprint engine version ---
# MUST match the Chromium binary in the image. A UA that claims a newer Chrome
# than the engine actually is gets caught by JS feature probing.
# CHROME_FINGERPRINT_MAJOR=131
# CHROME_FINGERPRINT_FULL=131.0.6778.204

# Sidecar JA3/JA4 profile pool (comma separated, picked at random per request).
# Must stay consistent with CHROME_FINGERPRINT_MAJOR.
# TLS_SIDECAR_PROFILES=chrome131,chrome131,chrome131,chrome124,chrome120

# --- Captcha / Notifications ---
# These are stored in the database and managed via the settings API — no env vars needed:
#   PUT /v1/settings/captcha_api_key      (2Captcha API key)
#   PUT /v1/settings/webhook_url          (HTTP webhook for alerts)
#   PUT /v1/settings/discord_webhook_url  (Discord webhook)

# Lightweight operational ML (retry timing only)
OPS_ML_ENABLED=true
OPS_ML_STATE_DIR=./data


# --- Residential proxy gateway (optional) ---
# Supply the HTTP(S) proxy endpoint from your residential proxy provider.
# Credentials stay in the environment instead of the task database.
# Role-specific values override the common endpoint.
# RESIDENTIAL_PROXY_URL=http://user:password@gateway.example:8000
# RESIDENTIAL_MONITOR_PROXY_URL=http://user:password@monitor-gateway.example:8000
# RESIDENTIAL_CHECKOUT_PROXY_URL=http://user:password@checkout-gateway.example:8000

# Residential bandwidth budgets are separate: 1 GiB/month for monitoring and 1 GiB/month for checkout by default.
RESIDENTIAL_MONITOR_MONTHLY_BUDGET_MB=1024
RESIDENTIAL_CHECKOUT_MONTHLY_BUDGET_MB=1024
RESIDENTIAL_MONTHLY_BUDGET_MB=1024
RESIDENTIAL_BUDGET_STRICT=true
RESIDENTIAL_MONITOR_RESERVE_MB=8
RESIDENTIAL_CHECKOUT_RESERVE_MB=8
# Optional persistent state file for the monthly usage counter.
# RESIDENTIAL_BUDGET_FILE=./data/residential-bandwidth.json

# Checkout performance
CHECKOUT_FAST_FILL=true
CHECKOUT_FAST_UI=true
REQUEST_MODE_PROBE_HOTPATH=false

# --- Low-RAM hosts (<= 2.5 GB) ---
# Below ~2.5 GB the checkout governor switches itself into a low-RAM profile
# automatically: one browser at a time, a hard renderer-process cap, reduced
# disk/media caches, and Chromium's memory-pressure handling off (it fights the
# OS on a small box). Nothing here needs to be set to get that behavior — these
# only override the tuned defaults.
# PREWARM_LOW_RAM=true   # park a browser on a tiny host (default: no, it costs RAM)

# --- Residential gateway concurrency ---
# The monthly BYTE budget below does not limit how many sticky gateway sessions
# are open at once. Without a separate cap, every armed task admitted at a drop
# opens its own upstream session and the provider's exit pool becomes the
# bottleneck. Callers wait up to SESSION_WAIT_MS, then proceed anyway — a
# slightly over-subscribed gateway beats a missed drop.
RESIDENTIAL_MAX_SESSIONS_PER_ROLE=4
RESIDENTIAL_SESSION_WAIT_MS=2500


# Lightweight browser/task density mode. This changes only Chromium resource overhead;
# checkout/site workflows remain the same.
LIGHTWEIGHT_TASK_MODE=true

# Host performance
CPU_PERFORMANCE_MODE=max
CHECKOUT_CONCURRENCY_CAP=32
# Soft RAM budget used by the adaptive checkout governor per live Chromium task.
CHECKOUT_MEMORY_BUDGET_MB=500
CHECKOUT_RESERVED_MEMORY_MB=2048
# Approximate target for browserless monitor bookkeeping; this is not a hard OS limit.
TASK_MEMORY_BUDGET_MB=200
# Set to false only on a host with a large /dev/shm; true caps Chromium's shared
# memory use, which is what container defaults require.
DISABLE_DEV_SHM_USAGE=true
# Leave UV_THREADPOOL_SIZE unset to derive it from the core count at boot.
# UV_THREADPOOL_SIZE=8
HTTP_MAX_SOCKETS=64
HTTP_MAX_FREE_SOCKETS=16
HTTP_SOCKET_TIMEOUT_MS=30000

RESIDENTIAL_MONITOR_CLEAN_POLLS=2
RESIDENTIAL_MONITOR_RESULT_CACHE_MS=1500
