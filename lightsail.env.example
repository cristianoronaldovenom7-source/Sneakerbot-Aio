NODE_ENV=production
PORT=3000
DB_POOL_MAX=5
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# The deploy script overwrites this with `openssl rand -hex 32` on first run.
# compose interpolates it from this file, so it must not stay at the placeholder.
SESSION_SECRET=replace-with-a-random-64-character-secret
# How deploy-lightsail.sh installs the app: docker (default, installs Docker +
# compose automatically), systemd (straight on the host), or auto (docker, and
# fall back to systemd if the engine cannot be installed).
# DEPLOY_MODE=docker
# Seconds the deploy waits for /healthz before printing logs. The first build
# pulls Chromium, so a cold box needs a generous window.
# HEALTH_PROBE_SECS=90
# DATABASE_URL=postgresql://...

# Optional residential provider gateway. Use your provider's HTTPS/HTTP proxy URL.
# RESIDENTIAL_PROXY_URL=http://user:password@gateway.example:8000
# RESIDENTIAL_MONITOR_PROXY_URL=http://user:password@monitor-gateway.example:8000
# RESIDENTIAL_CHECKOUT_PROXY_URL=http://user:password@checkout-gateway.example:8000

# Checkout performance
CHECKOUT_FAST_FILL=true
CHECKOUT_FAST_UI=true
REQUEST_MODE_PROBE_HOTPATH=false


# Performance tuning
CPU_PERFORMANCE_MODE=max
# Heavyweight Chromium checkouts. The effective value is further clamped at
# runtime by core count and free RAM; 10 is unreachable on a 1–2 vCPU box and
# setting it that high just queues work it cannot run.
CHECKOUT_CONCURRENCY_CAP=6
# Cold-start RAM reserved for the OS + Node before extra browsers are allowed.
CHECKOUT_RESERVED_MEMORY_MB=1024
# Leave UV_THREADPOOL_SIZE unset to let start.sh derive it from the core count.
# UV_THREADPOOL_SIZE=8

# HTTP keep-alive pool toward the stock APIs / WAF endpoints.
HTTP_MAX_SOCKETS=64
HTTP_MAX_FREE_SOCKETS=16
HTTP_SOCKET_TIMEOUT_MS=30000

# --- Best Buy / Pokemon Center drop tuning ---
# How many times the PDP is re-polled while the product is not yet addable.
# The API monitor arms the task the instant stock flips, which is usually a few
# hundred ms before the page finishes rendering — this window is what the poll
# loop covers. 60 attempts at the built-in backoff is roughly 3 minutes.
# BESTBUY_MONITOR_ATTEMPTS=60

# Captcha pre-solve stockpile (Best Buy + Pokemon Center). Tokens are solved in
# the background and consumed instantly at checkout, so the drop path does not
# wait on a solver. Depth is per sitekey; refill is the background check interval.
# CAPTCHA_STOCKPILE_DEPTH=2
# CAPTCHA_STOCKPILE_REFILL_MS=30000
